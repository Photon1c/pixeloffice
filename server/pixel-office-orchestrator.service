[Unit]
Description=Pixel Office Agent Orchestrator
After=network.target ollama.service

[Service]
Type=simple
User=sherlockhums
WorkingDirectory=/opt/pixeloffice/server
ExecStart=/usr/bin/node orchestrator.cjs --start
Restart=on-failure
RestartSec=10
StandardOutput=append:/opt/pixeloffice/data/orchestrator.log
StandardError=append:/opt/pixeloffice/data/orchestrator.log

Environment="PIXEL_OFFICE_URL=http://localhost:4173"

[Install]
WantedBy=multi-user.target