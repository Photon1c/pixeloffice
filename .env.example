# Pixel Office – Example Environment Variables
# Copy this file to `.env.local` (for Vite dev) or `.env` and fill in real values.

# --- Frontend Modes ---
# Public vs Lab mode.
# Typical dev:   VITE_PUBLIC_MODE=false, VITE_LAB_MODE=true
# Typical prod:  VITE_PUBLIC_MODE=true,  VITE_LAB_MODE=false
VITE_PUBLIC_MODE=false
VITE_LAB_MODE=true

# --- Supabase (Frontend) ---
# Public, anon key for in-browser Supabase client.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"

# --- Supabase (Server / Admin) ---
# Used by server/cooler/coolerToScrum.ts for admin-level operations.
# In production, prefer SUPABASE_SERVICE_KEY and keep it server-side only.
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=""
SUPABASE_SERVICE_KEY=""

# --- Core Database (pixel_memory) ---
# Shared DB config for pixel_memory (server + tools).
# See docs/complete/pixel_memory_SPEC.md and INTEGRATION_LOG_pixel_memory.md.
CORE_DB_HOST="your-db-host"
CORE_DB_PORT="5432"                 # or 3306 for MySQL
CORE_DB_NAME="your-db-name"
CORE_DB_USER="your-db-user"
CORE_DB_PASS="your-db-password"
CORE_DB_TYPE="postgres"             # "postgres" or "mysql"

# --- AI / External Services (optional) ---
# OpenAI API key for chat or LLM features.
OPENAI_API_KEY="your-openai-api-key"

# --- Local Ollama ---
# Base URL of the Ollama server used for local model inference.
# Pixel Office reads this in /api/ollama/* and the model registry.
# Default if unset: http://localhost:11434
# Override when running Ollama on a different host/port (e.g. remote GPU box):
#   OLLAMA_URL="http://192.168.1.20:11434"
OLLAMA_URL="http://localhost:11434"

# GitHub repo + branch used by SAFE SCRUM workflows.
SAFE_SCRUM_REPO="owner/repo"
SAFE_SCRUM_BRANCH="main"

# GitHub token (for SAFE SCRUM or other GitHub API usage).
GITHUB_TOKEN="your-github-token"

# NVIDIA key if using NVIDIA inference APIs.
NVIDIA_API_KEY="your-nvidia-api-key"

# --- Loop Tightening: Auto-Run + Artifact Cleanup ---
# AUTO_RUN_INTERVAL_MS — how often the auto-runner picks up pending scrum
# candidates and advances sessions (milliseconds). Default 180000 (3 min).
# AUTO_RUN_INTERVAL_MS="180000"

# CLEANUP_AUTOSTART — set to "true" to start the cleanup background tick
# automatically when Pixel Office boots. Off by default so retention is
# opt-in. Once enabled, POST /api/admin/cleanup can also be triggered manually.
# CLEANUP_AUTOSTART="false"

# CLEANUP_INTERVAL_MS — how often the cleanup tick fires (ms). Default 3600000 (1h).
# CLEANUP_INTERVAL_MS="3600000"

# CLEANUP_DEFAULT_DAYS — retention for cooler markdown + cooler_sessions +
# scrum candidates + cooler_talk_log. Default 14.
# CLEANUP_DEFAULT_DAYS="14"

# CLEANUP_SCRUM_DAYS — retention for scrum_logs + SCRUM_REPORTS + docs/scrum.
# Default 30.
# CLEANUP_SCRUM_DAYS="30"

# --- Admin / Security (optional, for admin UIs) ---
# If you use an admin token for protected routes, wire it through here.
# NOTE: For public deployments, avoid exposing sensitive tokens as VITE_ vars.
VITE_ADMIN_ACCESS_TOKEN=""

# --- API Base URL (optional) ---
# If the frontend talks to an external backend instead of relative `/api` routes,
# set this to that server's base URL.
# Example (local dev): http://localhost:3000
VITE_API_BASE_URL=""
